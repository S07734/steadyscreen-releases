#!/bin/bash
# Install a Display System component sent on stdin, validate it, and roll back
# if the client fails to come up afterwards.
#
#   cat kiosk.py | sudo kiosk-deploy kiosk.py
#
# Deliberately NOT "sudo install anything anywhere": the component name is
# checked against a fixed table, so granting this through sudoers does not
# hand out arbitrary root file writes.
set -uo pipefail
[ "$(id -u)" = 0 ] || { echo "must run as root" >&2; exit 1; }

BACKUP=/usr/local/lib/kiosk/backup
mkdir -p "$BACKUP"

case "${1:-}" in
  kiosk.py)         DEST=/usr/local/bin/kiosk.py;              MODE=0755; KIND=py ;;
  kioskctl)         DEST=/usr/local/bin/kioskctl;              MODE=0755; KIND=sh ;;
  kiosk-session)    DEST=/usr/local/bin/kiosk-session;         MODE=0755; KIND=sh ;;
  kiosk-splash)     DEST=/usr/local/sbin/kiosk-splash;         MODE=0755; KIND=sh ;;
  kiosk-set-name)   DEST=/usr/local/sbin/kiosk-set-name;       MODE=0755; KIND=sh ;;
  kiosk-sshd-auth)  DEST=/usr/local/sbin/kiosk-sshd-auth;      MODE=0755; KIND=sh ;;
  kiosk-passwd)     DEST=/usr/local/sbin/kiosk-passwd;         MODE=0755; KIND=sh ;;
  kiosk-cec)        DEST=/usr/local/sbin/kiosk-cec;            MODE=0755; KIND=sh ;;
  kiosk-audio)      DEST=/usr/local/sbin/kiosk-audio;          MODE=0755; KIND=sh ;;
  kiosk-printer)    DEST=/usr/local/sbin/kiosk-printer;        MODE=0755; KIND=sh ;;
  kiosk-testpage)   DEST=/usr/local/sbin/kiosk-testpage;       MODE=0755; KIND=py ;;
  kiosk-hwid)       DEST=/usr/local/sbin/kiosk-hwid;           MODE=0755; KIND=py ;;
  kiosk-deploy)     DEST=/usr/local/sbin/kiosk-deploy;         MODE=0755; KIND=sh ;;
  kiosk-update)     DEST=/usr/local/sbin/kiosk-update;         MODE=0755; KIND=sh ;;
  kiosk-osupdate)   DEST=/usr/local/sbin/kiosk-osupdate;       MODE=0755; KIND=sh ;;
  kiosk-migrate-boot) DEST=/usr/local/sbin/kiosk-migrate-boot;  MODE=0755; KIND=sh ;;
  grub-ab.cfg)      DEST=/usr/local/share/steadyscreen/grub-ab.cfg
                    MODE=0644; KIND=grubcfg ;;
  kiosk-diag)       DEST=/usr/local/sbin/kiosk-diag;           MODE=0755; KIND=sh ;;
  sudoers)          DEST=/etc/sudoers.d/kiosk;                 MODE=0440; KIND=sudoers ;;
  cups-filter)      DEST=/usr/lib/cups/filter/rastertotmt88v;   MODE=0755; KIND=any ;;
  escpos-filter)    DEST=/usr/lib/cups/filter/rastertoescpos;   MODE=0755; KIND=py ;;
  escpos-ppd)       DEST=/usr/share/cups/model/steadyscreen-escpos.ppd
                    MODE=0644; KIND=any ;;
  cups-ppd)         DEST=/usr/share/cups/model/epson-thermal-printer/epson-tm-t88v-rastertotmt88v.ppd
                    MODE=0644; KIND=any ;;
  readme)           DEST=/home/kiosk/README.md;                MODE=0644; KIND=any ;;
  *) echo "usage: kiosk-deploy <component>  (component read from stdin)" >&2
     echo "known: kiosk.py kioskctl kiosk-session kiosk-splash kiosk-set-name kiosk-update kiosk-diag" >&2
     echo "       kiosk-sshd-auth kiosk-passwd kiosk-cec kiosk-audio" >&2
     echo "       kiosk-printer kiosk-testpage" >&2
     echo "       kiosk-deploy kiosk-osupdate kiosk-migrate-boot grub-ab.cfg" >&2
     echo "       sudoers readme cups-filter cups-ppd" >&2
     echo "       escpos-filter escpos-ppd" >&2
     exit 1 ;;
esac

mkdir -p "$(dirname "$DEST")"
TMP=$(mktemp); trap 'rm -f "$TMP"' EXIT
cat > "$TMP"
[ -s "$TMP" ] || { echo "nothing on stdin" >&2; exit 1; }

# Validate before replacing anything. A broken sudoers file locks you out of
# root entirely; a broken kiosk.py takes the screen down.
case "$KIND" in
  py)      python3 -m py_compile "$TMP" || { echo "python syntax error, refusing" >&2; exit 1; } ;;
  sh)      bash -n "$TMP" 2>/dev/null || sh -n "$TMP" || { echo "shell syntax error, refusing" >&2; exit 1; } ;;
  sudoers) visudo -cf "$TMP" >/dev/null || { echo "sudoers syntax error, refusing" >&2; exit 1; } ;;
  # A truncated boot config is the one file here that can leave a machine
  # unbootable with nothing to read the error from. Check it says what it
  # has to say before it replaces the copy the migration will install.
  grubcfg) grep -q 'ds_slot' "$TMP" && grep -q 'menuentry' "$TMP" \
             || { echo "that is not the A/B arbiter, refusing" >&2; exit 1; } ;;
esac

[ -f "$DEST" ] && cp -a "$DEST" "$BACKUP/$(basename "$DEST").prev"
install -m "$MODE" "$TMP" "$DEST"
[ "$KIND" = py ] && rm -rf /usr/local/bin/__pycache__ 2>/dev/null
echo "installed $DEST"

# Only kiosk.py can take the screen down, so only it gets the restart-and-check.
[ "${1:-}" = kiosk.py ] || exit 0

port=$(sed -n 's/.*"admin_port"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' \
       /etc/kiosk/config.json 2>/dev/null); : "${port:=8080}"

pkill -f 'local/bin/[k]iosk\.py' 2>/dev/null
for i in $(seq 1 30); do
    sleep 1
    if curl -fsS -m 2 "http://127.0.0.1:$port/api/status" >/dev/null 2>&1; then
        echo "kiosk came back after ${i}s"
        exit 0
    fi
done

echo "kiosk did NOT come back within 30s" >&2
# Distinguish "the payload is broken" from "there is no display to run on".
# Rolling back cannot fix a missing X server, and blaming the file sends you
# looking in the wrong place.
if ! pgrep -x Xorg >/dev/null 2>&1; then
    echo "NOTE: no Xorg process is running - the X session is down, so no" >&2
    echo "      version of kiosk.py can start. Reboot the machine; this is" >&2
    echo "      not a fault in the file just deployed." >&2
fi
echo "rolling back" >&2
if [ -f "$BACKUP/kiosk.py.prev" ]; then
    install -m 0755 "$BACKUP/kiosk.py.prev" "$DEST"
    pkill -f 'local/bin/[k]iosk\.py' 2>/dev/null
    for i in $(seq 1 30); do
        sleep 1
        curl -fsS -m 2 "http://127.0.0.1:$port/api/status" >/dev/null 2>&1 && {
            echo "rolled back to the previous version" >&2; exit 2; }
    done
    echo "rollback also failed - needs hands on the machine" >&2
fi
exit 2
