#!/bin/sh
# X session for the kiosk: no window manager, no desktop, just the browser.
# Started by ~/.xinitrc. If the browser dies it is restarted immediately.

# never blank, never sleep, no screensaver
xset s off
xset s noblank
xset -dpms

# no bell, and no way to kill the server from the keyboard
xset -b
setxkbmap -option terminate:ctrl_alt_bksp 2>/dev/null || true

# Hide the pointer when nobody is using it.
#
# A mouse arrow parked in the middle of a menu board is the single most common
# thing that makes one of these look like a computer that has crashed rather
# than a sign. It reappears the moment the mouse moves, so setting a machine up
# with a mouse plugged in still works normally.
#
# --hide-on-touch matters on the touchscreens: a tap would otherwise leave the
# pointer sitting where the finger was, which is worse than never showing it.
# unclutter-xfixes, not the ancient unclutter -- the old one polls the pointer
# position on a timer and fights full-screen applications.
if command -v unclutter >/dev/null 2>&1; then
    unclutter --timeout 5 --hide-on-touch --ignore-scrolling &
fi

# black root window so nothing flashes white during a restart
# the splash colour, not black: one continuous background from plymouth
# through X to the first page
xsetroot -solid "#12141a"

# One line of Debian appears over the retained splash on every boot without
# this. /etc/motd being empty is only half the job: pam_motd also prints
# /run/motd.dynamic, and login suppresses that only when ~/.hushlogin exists.
#
# It has to be created here, on the client, rather than in the image:
# /home/kiosk is bind-mounted from /data, so the copy build-rootfs.sh puts in
# the squashfs is hidden by the mount, and an install that keeps the data
# partition never gets one. No component update can carry a dotfile either.
# Creating it here heals every existing machine on its next boot.
[ -e "$HOME/.hushlogin" ] || : > "$HOME/.hushlogin" 2>/dev/null || true

# WebKit's DMA-BUF renderer hands buffers straight to the GPU, and on drivers
# that do not implement the export it needs the page still composites -- so
# the browser reports no error, the admin page looks healthy, and the screen
# shows a black rectangle where the video is. It is a per-driver problem, so
# it appears when a machine is swapped rather than when anything changes here.
#
# Set here rather than in the image because this is a component: it reaches
# every existing client on the next update, and a machine that is already
# showing a black video does not have to be reinstalled to be fixed.
export WEBKIT_DISABLE_DMABUF_RENDERER=1

while : ; do
    /usr/local/bin/kiosk.py
    code=$?
    echo "kiosk: browser exited ($code), restarting in 2s" >&2
    sleep 2
done
