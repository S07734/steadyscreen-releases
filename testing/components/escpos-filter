#!/usr/bin/python3
"""CUPS filter: rendered page in, ESC/POS raster out.

This is the bridge between WebKit and a thermal printer. WebKit prints a page,
CUPS hands it here as PDF, and this emits the `GS v 0` raster command that
essentially every ESC/POS thermal printer understands -- Epson, Bixolon, Star
in ESC/POS mode, and the generic 58/80 mm units. A raw queue cannot do this on
its own: raw means "send these bytes untouched", and a rendered page is not
ESC/POS bytes.

Why PDF in rather than CUPS raster: the exact dot width matters on thermal
paper, and taking PDF lets this control the rasterisation itself instead of
accepting whatever width the chain upstream chose. 80 mm paper is 576 dots and
58 mm is 384, at the 203 dpi every one of these printers uses.

Deliberately not a driver for any particular printer. `GS v 0` is the common
subset, so this replaces a per-model driver rather than adding another one --
which also gets the GPL-3 TM-T88V driver off the image.

CUPS calls filters as:  filter job user title copies options [file]
"""
import json
import os
import subprocess
import sys
import tempfile

ESC = b"\x1b"
GS = b"\x1d"

# 203 dpi is universal on these printers. Printable dots, not paper width:
# 80 mm paper prints 72 mm, 58 mm paper prints 48 mm.
DPI = 203
# 80 mm is 512 here, not the arithmetic 576. Both printers this has ever run
# against are 512, established by ruler prints; and being too narrow wastes
# paper while being too wide crops the right hand side of every receipt.
WIDTHS = {"80": 512, "58": 384}
DEFAULT_DOTS = 512

# Most printers accept a very tall single raster, but some choke well before
# the 65535 the protocol allows, and a short chunk costs nothing.
CHUNK_ROWS = 128

# White dots to leave below the last ink before the feed and the cut.
#
# ~3 mm at 203 dpi. The `ESC d 4` feed further down is what actually clears
# the cutter; this is only so the crop does not slice the descenders off the
# last line of text.
TRAIL_DOTS = 24


def log(msg):
    # CUPS collects stderr into the job log; the DEBUG prefix keeps it out of
    # the operator's face unless they go looking.
    print("DEBUG: rastertoescpos: %s" % msg, file=sys.stderr)


# Set per client by `kiosk-printer width`, measured with `kiosk-printer ruler`.
PRINTER_CFG = "/etc/kiosk/printer.json"


def configured_dots():
    """This client's printable width for the queue being printed to.

    Per queue, with a client-wide default behind it. One number per client was
    fine while a display had one printer and wrong as soon as it had two: the
    TM-T88V on .63 is set to 64 mm and prints 512 dots, the TP200 beside it
    takes more, and whichever loses prints short without saying anything.

    cupsd puts the queue name in PRINTER for every filter it runs -- `PRINTER=%s`
    is in the daemon binary -- so the filter can look up its own queue rather
    than being told by whoever submitted the job. That matters because the
    caller that counts is a store's web page calling window.print(), which
    knows nothing about any of this.
    """
    queue = os.environ.get("PRINTER", "")
    try:
        with open(PRINTER_CFG) as fh:
            cfg = json.load(fh)
        if not isinstance(cfg, dict):
            return None
    except Exception:                                         # noqa: BLE001
        return None

    def ok(v):
        try:
            v = int(v)
        except (TypeError, ValueError):
            return None
        return v if 128 <= v <= 1024 else None

    if queue:
        val = ok((cfg.get("queues") or {}).get(queue, {}).get("width_dots"))
        if val is not None:
            return val
    return ok(cfg.get("width_dots"))


def dots_from_options(opts):
    """Dot width: the job's own option, else this client's, else 80 mm."""
    for token in opts.replace(",", " ").split():
        key, _, val = token.partition("=")
        key = key.lower()
        if key in ("escposwidth", "escpos-width", "widthdots") and val.isdigit():
            return int(val)
        if key in ("pagesize", "media"):
            for name, dots in WIDTHS.items():
                if name in val:
                    return dots
    return configured_dots() or DEFAULT_DOTS


def proto_from_options(opts):
    """"escpos" or "star" -- which language this printer actually speaks.

    A Star TSP100/TSP143 is not an ESC/POS printer. It says so itself:

        MFG:Star;CMD:STAR;MDL:TSP143 (STR_T-001)

    Sent GS v 0 raster it discards the lot and prints nothing at all -- no
    error, no paper, no jam. 48,954 bytes went into one on 2026-09-04 and
    the queue reported the job completed. That silence is why this is a
    per-queue setting rather than something guessed at print time.
    """
    for token in opts.replace(",", " ").split():
        key, _, val = token.partition("=")
        if key.lower() in ("escposproto", "escpos-proto", "ssproto"):
            return "star" if val.lower() in ("star", "starline", "starprnt") \
                          else "escpos"

    # Then the queue's own PPD, which is where the setting actually lives.
    #
    # CUPS does not repeat a PPD DEFAULT in the options string -- it passes
    # what the job asked for and expects a filter to read its own PPD for the
    # rest. Relying on argv[5] alone meant a queue set to Star still emitted
    # ESC/POS, and a Star printer discards that silently: the job goes to
    # "sending data to printer" and no paper ever moves. Seen on .94.
    #
    # Note the existing cut option never depended on this either: it tests for
    # the PRESENCE of "nocut" rather than reading a default.
    ppd = os.environ.get("PPD", "")
    if ppd:
        try:
            with open(ppd, "r", errors="replace") as fh:
                for line in fh:
                    if line.startswith("*DefaultEscposProto:"):
                        val = line.split(":", 1)[1].strip().lower()
                        return "star" if "star" in val else "escpos"
        except OSError:
            pass
    return "escpos"


def star_raster(img, cut):
    """One page as Star Line Mode raster.

    The framing, proven on a TSP143 before any of this was written:

        ESC @            initialise
        ESC * r A        enter raster mode
        ESC * r P 0 NUL  page length 0 -- continuous, so the page ends when
                         the data does rather than at a fixed length
        b lo hi <row>    one raster line, length little-endian
        ESC * r B        leave raster mode
        ESC d 3          partial cut, feeding clear of the head first

    Bit sense is the same as ESC/POS -- 1 fires the head -- and PIL mode '1'
    has 0 as black, so it inverts. Sent a line at a time: unlike GS v 0 there
    is no row count in the header to get wrong, and a truncated job stops
    mid-receipt instead of desynchronising the printer.
    """
    width, height = img.size
    row_bytes = (width + 7) // 8
    px = img.load()
    out = bytearray()
    out += ESC + b"@"
    out += ESC + b"*rA"
    out += ESC + b"*rP0\x00"
    for y in range(height):
        packed = bytearray(row_bytes)
        for x in range(width):
            if not px[x, y]:                       # 0 == black == print it
                packed[x >> 3] |= 0x80 >> (x & 7)
        out += b"b" + bytes([row_bytes & 0xFF, (row_bytes >> 8) & 0xFF])
        out += packed
    out += ESC + b"*rB"
    if cut:
        out += ESC + b"d" + bytes([3])
    return bytes(out)


def trim_to_content(img):
    """Crop everything below the last dot of ink. None if the page is blank.

    THIS IS WHAT STOPS A RECEIPT BEING TEN FEET LONG.
    
    The page arrives as tall as the application declared it, and for a receipt
    that is deliberately enormous: kiosk.py asks for a 3276 mm page so a long
    receipt is never split across pages and cut in half. Nothing downstream
    shortened it, so every one of those ~26,000 blank rows was rasterised and
    sent to the printer, and the printer dutifully fed all 3.2 metres of it.
    Measured at Flying Fish Memphis, 2026-09-03: "a couple of characters at
    the top and then about 10 feet of blank paper".

    Trimming belongs HERE rather than in the page size, because it is right
    for every job whatever declared it -- a customer's HTML receipt, a test
    page, anything -- and because shortening the page instead would risk
    paginating a long receipt into two, which is a worse failure: a receipt
    cut in half is not obviously wrong until somebody reads it.

    getbbox() on the inverted image does the scan in C. Doing it in Python
    over 15 million pixels would cost more than the printing.
    """
    from PIL import ImageOps

    # Mode "1": 0 is black. getbbox() finds NON-zero, so invert first or it
    # would return the bounding box of the white, which is the whole page.
    ink = ImageOps.invert(img.convert("L")).getbbox()
    if ink is None:
        return None
    bottom = min(img.height, ink[3] + TRAIL_DOTS)
    if bottom >= img.height:
        return img                      # already tight; nothing to crop
    return img.crop((0, 0, img.width, bottom))


def render(path, dots):
    """PDF -> 1-bit rows of exactly `dots` width, via pdftoppm."""
    from PIL import Image

    with tempfile.TemporaryDirectory() as tmp:
        stem = os.path.join(tmp, "p")
        # -gray, not -mono. A thermal head is one bit per dot either way, but
        # -mono thresholds: every pixel is simply above or below a cutoff, so
        # a logo with any gradient in it prints as black blobs. Rendering grey
        # and letting PIL dither (Floyd-Steinberg, which convert("1") does by
        # default) turns those gradients into stipple, which is what makes
        # graphics readable on receipt paper.
        #
        # -scale-to-x pins the dot width so the page lands at exactly the
        # right size whatever the HTML claimed.
        subprocess.run(
            ["pdftoppm", "-gray", "-r", str(DPI), "-scale-to-x", str(dots),
             "-scale-to-y", "-1", path, stem],
            check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        pages = sorted(f for f in os.listdir(tmp) if f.startswith("p"))
        if not pages:
            raise RuntimeError("pdftoppm produced no pages")
        for page in pages:
            img = Image.open(os.path.join(tmp, page)).convert("1")   # dithers
            if img.width != dots:                      # pad, never scale again
                canvas = Image.new("1", (dots, img.height), 1)
                canvas.paste(img, (0, 0))
                img = canvas
            tall = img.height
            img = trim_to_content(img)
            if img is None:
                # Nothing on it at all. Feeding a blank page through a thermal
                # printer just wastes the roll, and saying so in the job log
                # is more use than a metre of nothing.
                log("page %s is blank; not printing it" % page)
                continue
            if img.height != tall:
                log("trimmed %d rows of trailing blank to %d (%.0f mm)"
                    % (tall - img.height, img.height, img.height * 25.4 / DPI))
            yield img


def escpos_raster(img):
    """One page as GS v 0 chunks. In PIL mode '1', 0 is black; ESC/POS wants
    a 1 bit where it should fire the head, so the sense is inverted."""
    width, height = img.size
    row_bytes = (width + 7) // 8
    px = img.load()
    out = bytearray()
    for top in range(0, height, CHUNK_ROWS):
        rows = min(CHUNK_ROWS, height - top)
        out += GS + b"v0" + bytes([0])
        out += bytes([row_bytes & 0xFF, (row_bytes >> 8) & 0xFF])
        out += bytes([rows & 0xFF, (rows >> 8) & 0xFF])
        for y in range(top, top + rows):
            packed = bytearray(row_bytes)
            for x in range(width):
                if not px[x, y]:                       # 0 == black == print it
                    packed[x >> 3] |= 0x80 >> (x & 7)
            out += packed
    return bytes(out)


def main():
    if len(sys.argv) < 6:
        print("ERROR: usage: rastertoescpos job user title copies options [file]",
              file=sys.stderr)
        return 1
    opts = sys.argv[5] or ""
    dots = dots_from_options(opts)
    cut = "nocut" not in opts.lower()
    proto = proto_from_options(opts)
    log("width %d dots, cut=%s, proto=%s" % (dots, cut, proto))

    src = sys.argv[6] if len(sys.argv) > 6 else None
    tmp_pdf = None
    if not src:
        # Job arrived on stdin; pdftoppm needs a seekable file.
        fd, tmp_pdf = tempfile.mkstemp(suffix=".pdf")
        with os.fdopen(fd, "wb") as fh:
            fh.write(sys.stdin.buffer.read())
        src = tmp_pdf

    out = sys.stdout.buffer
    try:
        if proto == "star":
            # Star does its own initialise, feed and cut inside the raster
            # framing, so nothing is written around it. Mixing the two -- an
            # ESC/POS cut after a Star page, say -- is how a printer ends up
            # in a mode the next job does not expect.
            for img in render(src, dots):
                out.write(star_raster(img, cut))
        else:
            out.write(ESC + b"@")                      # reset to a known state
            for img in render(src, dots):
                out.write(escpos_raster(img))
                out.write(ESC + b"d" + bytes([4]))     # feed clear of the head
                if cut:
                    out.write(GS + b"V" + bytes([66, 0]))   # partial cut
        out.flush()
    except subprocess.CalledProcessError as exc:
        print("ERROR: could not rasterise the page: %s"
              % (exc.stderr or b"").decode("utf-8", "replace")[:200],
              file=sys.stderr)
        return 1
    except Exception as exc:                           # noqa: BLE001
        print("ERROR: %s" % exc, file=sys.stderr)
        return 1
    finally:
        if tmp_pdf:
            os.unlink(tmp_pdf)
    return 0


if __name__ == "__main__":
    sys.exit(main())
