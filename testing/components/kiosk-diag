#!/bin/bash
# Read-only diagnostics, runnable through sudo without a password.
#
#   kiosk-diag fs | boot | disk | net | power | update | log | all
#
# Every command below is READ-ONLY and fixed. Nothing the caller supplies ever
# reaches a shell: the section name is matched against a case list and the
# commands are literals. That is what makes it safe to grant through sudoers,
# the same reasoning as kiosk-deploy's fixed component table.
#
# It exists because the questions that actually get asked in the field --
# "did this filesystem get repaired after the power went?", "is there a stale
# boot entry?" -- could not be answered as the kiosk user at all, and root was
# not available remotely. Diagnosing a fleet you cannot log into requires the
# answers to be reachable.
#
# Deliberately prints no secrets: no wifi keys, no passwords, no private keys.
set -uo pipefail

hdr() { printf '\n===== %s =====\n' "$1"; }
rootdev() { findmnt -no SOURCE / 2>/dev/null; }
rootdisk() { lsblk -no PKNAME "$(rootdev)" 2>/dev/null | head -1; }

sec_fs() {
    hdr "filesystems"
    # One at a time: findmnt given several targets fails wholesale if any one
    # is absent, which blanked the whole section on a machine without /data.
    local m
    for m in / /data /boot/efi /var/log/journal; do
        findmnt -no SOURCE,TARGET,FSTYPE,OPTIONS "$m" 2>/dev/null || echo "  $m  not mounted"
    done
    hdr "filesystem health (state, mounts since last check)"
    local d
    for d in $(lsblk -lno NAME,FSTYPE "/dev/$(rootdisk)" 2>/dev/null \
               | awk '$2=="ext4"{print $1}'); do
        echo "--- /dev/$d"
        dumpe2fs -h "/dev/$d" 2>/dev/null | grep -E \
          "Filesystem volume name|Filesystem state|Mount count|Maximum mount|Last checked|Lifetime writes|Free blocks"
    done
    hdr "space"
    df -h / /data /boot/efi 2>/dev/null
}

# The firmware's own answer, read straight out of the EFI variable.
#
# The first four bytes of an efivar are its attributes; the fifth is the value.
# mokutil would say the same thing and is not installed on this image.
secure_boot_state() {
    local f v
    f=$(ls /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -1)
    [ -n "$f" ] || { echo "not reported (no SecureBoot variable)"; return; }
    v=$(od -An -t u1 -j 4 -N 1 "$f" 2>/dev/null | tr -d ' \n')
    case "$v" in
        1) echo "ENABLED" ;;
        0) echo "off" ;;
        *) echo "not reported (unreadable)" ;;
    esac
}

sec_boot() {
    hdr "firmware"
    if [ -d /sys/firmware/efi ]; then
        echo "UEFI $(cat /sys/firmware/efi/fw_platform_size 2>/dev/null)-bit"
        # Secure Boot is a supported mode since 2026-09-03, so a display has
        # to be able to say whether it is in it. The EFI variable is the
        # firmware's own answer; the lockdown file is the kernel's, and the
        # two agreeing is what "on" actually means.
        echo "Secure Boot: $(secure_boot_state)"
        [ -r /sys/kernel/security/lockdown ] \
            && echo "kernel lockdown: $(cat /sys/kernel/security/lockdown)"
        hdr "NVRAM boot entries"
        efibootmgr -v 2>/dev/null || echo "efibootmgr unavailable"
    else
        echo "legacy BIOS (no efivars)"
    fi
    hdr "kernel command line"
    cat /proc/cmdline
}

sec_disk() {
    hdr "block devices"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT
    hdr "partition table of the system disk"
    sgdisk -p "/dev/$(rootdisk)" 2>/dev/null | head -20
}

sec_net() {
    hdr "interfaces"
    ip -br addr 2>/dev/null
    hdr "connectivity"
    nmcli -t -f STATE,CONNECTIVITY general 2>/dev/null
    hdr "saved networks (names only -- keys are never printed)"
    nmcli -t -f NAME,TYPE connection show 2>/dev/null | grep wireless || echo "none"
    hdr "wifi in range"
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null | head -12
}

sec_power() {
    hdr "uptime"
    uptime -p; echo "booted: $(uptime -s 2>/dev/null)"
    hdr "recent boots (a gap without a clean shutdown means the power went)"
    journalctl --list-boots --no-pager 2>/dev/null | tail -10
    hdr "unclean shutdowns recorded this boot"
    journalctl -b --no-pager 2>/dev/null \
      | grep -icE "ext4-fs .*(recovery|error)|unclean|dirty" \
      | sed 's/^/matching log lines: /'
}

sec_update() {
    hdr "installed version"
    sed -n 's/^VERSION = "\(.*\)"/\1/p' /usr/local/bin/kiosk.py 2>/dev/null | head -1
    hdr "update state"
    cat /var/lib/kiosk/update-state.json 2>/dev/null || echo "no update has run"
    hdr "update config"
    cat /etc/kiosk/update.json 2>/dev/null
    hdr "timer"
    systemctl list-timers kiosk-update.timer --no-pager 2>/dev/null | head -3
}

sec_log() {
    hdr "last 60 lines of this boot"
    journalctl -b -n 60 --no-pager 2>/dev/null
    hdr "client stderr"
    tail -n 40 /home/kiosk/.xsession-errors 2>/dev/null
}

# What can actually drive this screen, from the kernel up to X.
#
# The client reports touch:true from udev (ID_INPUT_TOUCHSCREEN) and names the
# device from `xinput`, and those two can disagree: the kernel can have a
# touchscreen that X never picks up, which is a screen that will not respond
# and reports itself as having touch. Nothing printed either side of that gap,
# so an Elo panel that worked under Windows could only be diagnosed by
# somebody with a shell on the machine.
#
# Every layer, in order, so the gap is visible rather than inferred.
sec_input() {
    hdr "USB devices"
    lsusb 2>/dev/null || echo "(lsusb not available)"

    hdr "kernel input devices"
    cat /proc/bus/input/devices 2>/dev/null || echo "(none)"

    hdr "what udev makes of each event node"
    for n in /dev/input/event*; do
        [ -e "$n" ] || continue
        printf '%s: ' "$n"
        udevadm info -q property -n "$n" 2>/dev/null \
            | grep -E "^(ID_INPUT_[A-Z]+=1|NAME=)" | tr '\n' ' '
        echo
    done

    hdr "touch-related kernel modules"
    lsmod 2>/dev/null | grep -iE "touch|elo|hid_multi|usbhid|evdev" \
        || echo "(none loaded)"

    # X is the half the client actually drives, and it needs a display and an
    # authority file: this runs as root from a timer or an API call, not from
    # the session.
    hdr "devices X has"
    DISPLAY=:0 XAUTHORITY=/home/kiosk/.Xauthority xinput list 2>&1 \
        || echo "(xinput unavailable)"

    # The properties are where a calibration lives. A touchscreen that
    # responds in the wrong place is not a broken panel: it is a matrix, and
    # without printing the matrix and the axis ranges next to the screen size
    # there is no way to tell an inverted axis from an uncalibrated one.
    hdr "properties of each pointer X has"
    for id in $(DISPLAY=:0 XAUTHORITY=/home/kiosk/.Xauthority xinput list \
                    --id-only 2>/dev/null); do
        nm=$(DISPLAY=:0 XAUTHORITY=/home/kiosk/.Xauthority \
             xinput list --name-only "$id" 2>/dev/null)
        case "$nm" in
            *[Tt]ouch*|*ELO*|*Elo*) ;;
            *) continue ;;
        esac
        echo "--- id=$id  $nm"
        DISPLAY=:0 XAUTHORITY=/home/kiosk/.Xauthority \
            xinput list-props "$id" 2>/dev/null \
            | grep -iE "matrix|calibrat|axis|enabled|mode" | sed 's/^/    /'
    done

    hdr "screen geometry (what the matrix has to map onto)"
    DISPLAY=:0 XAUTHORITY=/home/kiosk/.Xauthority xrandr --query 2>/dev/null \
        | grep -E " connected|\*" | head -6

    hdr "X input driver decisions"
    grep -iE "input|libinput|evdev|touch" /home/kiosk/.xsession-errors 2>/dev/null \
        | tail -25 || echo "(nothing)"
    for l in /var/log/Xorg.0.log /home/kiosk/.local/share/xorg/Xorg.0.log; do
        [ -f "$l" ] || continue
        hdr "$l"
        grep -iE "input device|libinput|evdev|touch|Elo" "$l" | tail -25
    done
}

# What has FAILED on this display, and what it said on the way down.
#
# A failed unit is invisible from the admin page: the display carries on, the
# page looks well, and whatever that unit did simply does not happen. avahi
# died on .178 and the only symptom was a printer scan that quietly returned
# nothing -- the reason was in the journal, which the kiosk user cannot read,
# so nobody could see it without a root shell.
#
# `systemctl --failed` alone names the unit and not the cause, so each one
# gets the lines it logged before it stopped.
sec_units() {
    hdr "failed units"
    systemctl --failed --no-pager --no-legend 2>/dev/null || echo "(none)"

    # --no-legend still prints a bullet in the first column, so $1 is "●" and
    # not a unit name. Pick the field that actually looks like a unit.
    for u in $(systemctl --failed --no-pager --no-legend 2>/dev/null \
               | awk '{for (i = 1; i <= NF; i++)
                         if ($i ~ /\.(service|socket|timer|mount|path)$/) {
                             print $i; break
                         }}'); do
        hdr "why $u stopped"
        journalctl -u "$u" -b -n 20 --no-pager 2>/dev/null \
            | grep -vE "Consumed|Deactivated|Scheduled restart" \
            | tail -12
    done

    # Not failed, but load-bearing and quiet when they go: the client depends
    # on all three and says nothing if they are absent.
    hdr "units this display depends on"
    for u in avahi-daemon NetworkManager cups; do
        printf '  %-18s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"
    done
}

case "${1:-all}" in
    fs)     sec_fs ;;
    boot)   sec_boot ;;
    disk)   sec_disk ;;
    net)    sec_net ;;
    power)  sec_power ;;
    update) sec_update ;;
    input)  sec_input ;;
    units)  sec_units ;;
    log)    sec_log ;;
    all)    sec_fs; sec_boot; sec_disk; sec_net; sec_power; sec_update; sec_input; sec_units ;;
    *) echo "usage: kiosk-diag {fs|boot|disk|net|power|update|input|units|log|all}" >&2; exit 1 ;;
esac
